{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.solvers.json",
    "dev": "node backend/dev-server.js",
    "test": "node --test",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "docs:generate": "node scripts/catalog-docs.mjs",
    "docs:check": "node scripts/catalog-docs.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run docs:check && npm test && npm run build",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "new-lab": "node scripts/new-lab.mjs",
    "package:build": "node scripts/build-solvers.mjs",
    "test:coverage": "node scripts/coverage.mjs",
    "test:lighthouse": "lhci autorun",
    "package:check": "node scripts/verify-package.mjs",
    "preview": "node backend/preview-server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "overrides": {
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "basic-ftp": "^6.2.6"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "jspdf": "^4.2.1",
    "three": "^0.187.0"
  }
}
